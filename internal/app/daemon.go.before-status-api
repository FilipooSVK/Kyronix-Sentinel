package app

import (
	"context"
	"time"

	"kyronix/sentinel/internal/domain"
	"kyronix/sentinel/internal/logging"
)

// Daemon runs Sentinel engine periodically.
type Daemon struct {

	engine *Engine

	period time.Duration

	logger *logging.Logger
}


// NewDaemon creates Sentinel daemon.
func NewDaemon(
	engine *Engine,
	period time.Duration,
	logger *logging.Logger,
) *Daemon {

	return &Daemon{
		engine: engine,
		period: period,
		logger: logger,
	}
}


// Run starts daemon lifecycle.
func (d *Daemon) Run(
	ctx context.Context,
) error {

	d.logger.Info(
		"sentineld started",
		nil,
	)


	ticker := time.NewTicker(
		d.period,
	)

	defer ticker.Stop()


	for {

		select {

		case <-ctx.Done():

			d.logger.Info(
				"sentineld stopping",
				nil,
			)

			return nil


		case <-ticker.C:

			result := d.engine.RunOnce()

			LogHealthResult(
				d.logger,
				result,
			)
		}
	}
}


// Keep domain import used explicitly.
var _ domain.HealthResult
